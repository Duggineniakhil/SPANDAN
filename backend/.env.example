# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://spandan:spandan@localhost:5433/spandan
TEST_DATABASE_URL=postgresql+psycopg://spandan:spandan@localhost:5433/spandan_test
# Shared bearer token for the phone app and dashboard (prototype only)
API_TOKEN=change-me
# LLM keys for the coordinator agent (tried in AGENT_PROVIDERS order)
GEMINI_API_KEY=
GROQ_API_KEY=
AGENT_PROVIDERS=groq,gemini
# Approval engine: reminder/expiry sweep interval in seconds (0 = off)
APPROVAL_SWEEP_INTERVAL_S=300
# Voice (Gnani / vachana.ai): TTS voice note out, STT of the owner's spoken reply.
# Empty = no voice; the owner reads the text and taps Approve/Reject.
GNANI_API_KEY=
# Generated voice notes and recorded replies (gitignored)
VOICE_DIR=var/voice
